# CMake / Ninja build output (never version generated trees)
/build-tsf*/
/heshun-tsf/build-tsf/
/heshun-tsf/build/
/heshun-tsf/dist/
**/CMakeFiles/
**/Testing/Temporary/
CMakeCache.txt
cmake_install.cmake
build.ninja
.ninja_deps
.ninja_log
*.obj
*.pdb
*.exp
*.ilk
*.rc.res

# Rust build output
/target/
**/target/

# Runtime-generated local state and logs
/data/
/dist/
**/*.userdb.json
*.log
heshun-tsf.log

# Local IDE / OS files
/.idea/
/.vscode/
*.swp
*.suo
*.user
Thumbs.db
Desktop.ini

# Do not commit built dynamic/static libraries or executables
*.dll
*.lib
*.a
*.exe

# Source-controlled binary dictionaries and the shipped default UI config.
!heshun/schemas/*.bin
!heshun-tsf/assets/heshun-ui.ini

# Local-only development notes and verification artifacts
/docs-dev/
